                       "<style>body{text-align:center; font-family:sans-serif; background:#f0f0f0; padding-top:40px;}"
                       "button{padding:12px 24px; font-size:16px; color:white; border:none; border-radius:6px; cursor:pointer; font-weight:bold; box-shadow: 0px 4px 6px rgba(0,0,0,0.1); margin-top:15px; margin-right: 10px;}"
                       ".btn-azul{background:#0056b3;} .btn-azul:active{transform: scale(0.98);}"
                       ".btn-rojo{background:#d32f2f; margin-top: 40px;} .btn-rojo:active{transform: scale(0.98);}"
                       "input[type=number]{padding:10px; font-size:16px; width:70px; text-align:center; border: 1px solid #ccc; border-radius:5px;} "
                       "hr{margin-top:40px; border: 0; border-top: 1px solid #ddd;}</style></head>"
                       "<body><h2>Recolección para Edge Impulse</h2>"
                       "<p>Formato configurado: 240x240px</p>"
                       "<form action='/guardar' method='GET'>" 
                       "<label for='lote' style='font-size:18px;'>Cantidad de fotos por lote: </label>"
                       "<input type='number' name='lote' id='lote' value='5' min='1' max='50'><br>"
                       "<button type='submit' class='btn-azul'>Capturar y Guardar en SD</button>"
                       "</form>"
                       "<hr>"
                       "<!-- Botón de borrado con alerta de confirmación JS -->"
                       "<form action='/borrar' method='GET' onsubmit=\"return confirm('ATENCIÓN: ¿Estás seguro de que deseas borrar TODAS las fotos del dataset? Esta acción no se puede deshacer.');\">"
                       "<button type='submit' class='btn-rojo'>Borrar todo el Dataset</button>"
