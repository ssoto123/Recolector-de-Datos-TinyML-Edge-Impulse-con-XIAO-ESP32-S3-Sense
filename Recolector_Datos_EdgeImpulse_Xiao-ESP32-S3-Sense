// =========================================================================
// CONFIGURACIÓN DEL SERVIDOR WEB
// =========================================================================
void startCameraServer() {
    httpd_config_t server_config = HTTPD_DEFAULT_CONFIG();
    server_config.server_port = 80; 

    if (httpd_start(&camera_httpd, &server_config) == ESP_OK) {
        httpd_uri_t index_uri = { .uri = "/", .method = HTTP_GET, .handler = index_handler, .user_ctx = NULL };
        httpd_uri_t capture_save_uri = { .uri = "/guardar", .method = HTTP_GET, .handler = capture_save_handler, .user_ctx = NULL };
        httpd_uri_t ver_foto_uri = { .uri = "/ver_foto", .method = HTTP_GET, .handler = ver_foto_handler, .user_ctx = NULL };
        httpd_uri_t borrar_fotos_uri = { .uri = "/borrar", .method = HTTP_GET, .handler = borrar_fotos_handler, .user_ctx = NULL }; // Nuevo recepcionista
        
        httpd_register_uri_handler(camera_httpd, &index_uri);
        httpd_register_uri_handler(camera_httpd, &capture_save_uri);
        httpd_register_uri_handler(camera_httpd, &ver_foto_uri);
        httpd_register_uri_handler(camera_httpd, &borrar_fotos_uri);
    }
}

// =========================================================================
// SETUP (Configuración inicial al encender la placa)
// =========================================================================
void setup() {
    Serial.begin(115200);
    delay(2000);
    Serial.println("\n--- SISTEMA NATIVO INICIADO ---");

    SPI.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);
    if (!SD.begin(SD_CS, SPI)) {
        Serial.println("Atención: No se detectó MicroSD al iniciar.");
    } else {
        Serial.printf("MicroSD detectada. Espacio libre: %llu MB\n", SD.totalBytes() / (1024 * 1024));
    }

    camera_config_t config;
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;
    config.pin_d0 = Y2_GPIO_NUM; config.pin_d1 = Y3_GPIO_NUM; config.pin_d2 = Y4_GPIO_NUM; config.pin_d3 = Y5_GPIO_NUM;
    config.pin_d4 = Y6_GPIO_NUM; config.pin_d5 = Y7_GPIO_NUM; config.pin_d6 = Y8_GPIO_NUM; config.pin_d7 = Y9_GPIO_NUM;
    config.pin_xclk = XCLK_GPIO_NUM; config.pin_pclk = PCLK_GPIO_NUM; config.pin_vsync = VSYNC_GPIO_NUM;
    config.pin_href = HREF_GPIO_NUM; config.pin_sccb_sda = SIOD_GPIO_NUM; config.pin_sccb_scl = SIOC_GPIO_NUM;
    config.pin_pwdn = PWDN_GPIO_NUM; config.pin_reset = RESET_GPIO_NUM;
    
    config.xclk_freq_hz = 10000000; 
    config.frame_size = FRAMESIZE_240X240; 
    config.pixel_format = PIXFORMAT_JPEG; 
    config.fb_location = CAMERA_FB_IN_PSRAM; 
    config.jpeg_quality = 12; 
    config.grab_mode = CAMERA_GRAB_LATEST; 
    config.fb_count = 2; 

    if (esp_camera_init(&config) != ESP_OK) {
        Serial.println("Error crítico: Falló la inicialización de la cámara");
        return;
    }
    Serial.println("Cámara iniciada correctamente.");

    Serial.print("Conectando a la red WiFi ");
    WiFi.begin(ssid, password);
    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }
    Serial.println("\nWiFi conectado.");

    startCameraServer();
    Serial.println("=========================================");
    Serial.print("Servidor web listo en: http://");
    Serial.println(WiFi.localIP());
    Serial.println("=========================================");
}

void loop() {
    delay(10000); 
}
